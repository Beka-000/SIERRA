generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum FulfillmentType {
  dine_in
  pickup
  delivery
}

enum PaymentMethod {
  cash
  card
  online
}

enum OrderStatus {
  NEW
  CONFIRMED
  COOKING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  created
  pending
  success
  failed
  cancelled
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TableStatus {
  available
  unavailable
  maintenance
}

enum DiscountType {
  percent
  fixed
}

enum ReviewStatus {
  pending
  approved
  rejected
  hidden
}

enum NotificationType {
  order_created
  order_confirmed
  order_status_changed
  order_ready
  order_cancelled
  reservation_created
  reservation_reminder
  reservation_changed
  reservation_cancelled
  system
}

enum NotificationChannel {
  cabinet
  email
  telegram
  sms
}

// ─────────────────────────────────────────────
// ROLES
// ─────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  code        String   @unique // guest | client | staff | kitchen | manager | admin
  title       String
  permissions Json     @default("{}")

  users       User[]

  @@map("roles")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id                    String    @id @default(uuid())
  roleId                String    @map("role_id")
  name                  String
  phone                 String?   @unique
  email                 String?   @unique
  passwordHash          String?   @map("password_hash")
  googleId              String?   @unique @map("google_id")
  googleAvatar          String?   @map("google_avatar")
  isBlocked             Boolean   @default(false) @map("is_blocked")
  blockedReason         String?   @map("blocked_reason")
  blockedAt             DateTime? @map("blocked_at")
  blockedBy             String?   @map("blocked_by")
  lastSeenAt            DateTime? @map("last_seen_at")
  notificationsConsent  Boolean   @default(false) @map("notifications_consent")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  role                  Role              @relation(fields: [roleId], references: [id])
  blockedByUser         User?             @relation("BlockedByUser", fields: [blockedBy], references: [id], onDelete: SetNull)
  blockedUsers          User[]            @relation("BlockedByUser")
  profile               Profile?
  loyaltyAccount        LoyaltyAccount?
  carts                 Cart[]
  orders                Order[]
  reservations          Reservation[]
  notifications         Notification[]
  reviews               Review[]
  activityLogs          ActivityLog[]
  uploadedFiles         File[]            @relation("UploadedFiles")
  moderatedReviews      Review[]          @relation("ModeratedReviews")

  @@map("users")
}

// ─────────────────────────────────────────────
// PROFILES
// ─────────────────────────────────────────────

model Profile {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  favoriteProducts  String[]  @map("favorite_products") // UUID[] → Product.id
  avatarFileId      String?   @map("avatar_file_id")
  birthDate         DateTime? @map("birth_date") @db.Date
  notes             String?

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarFile        File?     @relation("AvatarFile", fields: [avatarFileId], references: [id])

  @@map("profiles")
}

// ─────────────────────────────────────────────
// FILES
// ─────────────────────────────────────────────

model File {
  id           String    @id @default(uuid())
  url          String
  storageKey   String    @map("storage_key")
  mimeType     String    @map("mime_type")
  sizeBytes    BigInt    @map("size_bytes")
  uploadedBy   String?   @map("uploaded_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  uploader     User?     @relation("UploadedFiles", fields: [uploadedBy], references: [id], onDelete: SetNull)
  profiles     Profile[] @relation("AvatarFile")
  products     Product[] @relation("ProductPhoto")

  @@map("files")
}

// ─────────────────────────────────────────────
// MENU CATEGORIES
// ─────────────────────────────────────────────

model MenuCategory {
  id          String    @id @default(uuid())
  title       String
  description String?
  imageUrl    String?   @map("image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  products    Product[]

  @@map("menu_categories")
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────

model Product {
  id              String    @id @default(uuid())
  categoryId      String    @map("category_id")
  title           String
  description     String?
  price           Decimal   @db.Decimal(10, 2)
  oldPrice        Decimal?  @map("old_price") @db.Decimal(10, 2)
  weightOrVolume  String?   @map("weight_or_volume")
  calories        Int?
  allergens       String?
  composition     String?
  photoFileId     String?   @map("photo_file_id")
  isAvailable     Boolean   @default(true) @map("is_available")
  isRecommended   Boolean   @default(false) @map("is_recommended")
  isHidden        Boolean   @default(false) @map("is_hidden")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category        MenuCategory       @relation(fields: [categoryId], references: [id])
  photoFile       File?              @relation("ProductPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  modifiers       ProductModifier[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  reviews         Review[]

  @@map("products")
}

// ─────────────────────────────────────────────
// PRODUCT MODIFIERS
// ─────────────────────────────────────────────

model ProductModifier {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  title       String
  priceDelta  Decimal  @default(0) @map("price_delta") @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_modifiers")
}

// ─────────────────────────────────────────────
// CARTS
// ─────────────────────────────────────────────

model Cart {
  id          String     @id @default(uuid())
  userId      String?    @map("user_id")
  sessionId   String?    @map("session_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]

  @@unique([userId])
  @@unique([sessionId])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String   @map("cart_id")
  productId  String   @map("product_id")
  quantity   Int      @default(1)
  modifiers  Json     @default("[]") // Выбранные модификаторы
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────
// PROMOCODES
// ─────────────────────────────────────────────

model Promocode {
  id                   String       @id @default(uuid())
  code                 String       @unique
  name                 String?
  description          String?
  discountType         DiscountType @map("discount_type")
  discountValue        Decimal      @map("discount_value") @db.Decimal(10, 2)
  maxDiscountAmount    Decimal?     @map("max_discount_amount") @db.Decimal(10, 2)
  minOrderAmount       Decimal?     @map("min_order_amount") @db.Decimal(10, 2)
  applicableProducts   String[]     @map("applicable_products")   // UUID[] → Product.id
  applicableCategories String[]     @map("applicable_categories") // UUID[] → MenuCategory.id
  usageLimit           Int?         @map("usage_limit")
  usedCount            Int          @default(0) @map("used_count")
  usesPerCustomer      Int?         @map("uses_per_customer")
  firstOrderOnly       Boolean      @default(false) @map("first_order_only")
  validFrom            DateTime     @map("valid_from")
  validUntil           DateTime     @map("valid_until")
  isActive             Boolean      @default(true) @map("is_active")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  orders               Order[]
  usages               PromocodeUsage[]

  @@map("promocodes")
}

// ─────────────────────────────────────────────
// PROMOCODE USAGE
// ─────────────────────────────────────────────

model PromocodeUsage {
  id            String    @id @default(uuid())
  promocodeId   String    @map("promocode_id")
  userId        String?   @map("user_id")
  orderId       String    @map("order_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  createdAt     DateTime  @default(now()) @map("created_at")

  promocode     Promocode @relation(fields: [promocodeId], references: [id], onDelete: Cascade)

  @@map("promocode_usages")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id              String          @id @default(uuid())
  orderNumber     String          @unique @map("order_number")
  userId          String?         @map("user_id")
  customerName    String          @map("customer_name")
  customerPhone   String          @map("customer_phone")
  customerEmail   String?         @map("customer_email")
  fulfillmentType FulfillmentType @map("fulfillment_type")
  deliveryAddress String?         @map("delivery_address")
  desiredTime     DateTime?       @map("desired_time")
  comment         String?
  paymentMethod   PaymentMethod   @map("payment_method")
  promocodeId     String?         @map("promocode_id")
  subtotal        Decimal         @db.Decimal(10, 2)
  discountAmount  Decimal         @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(10, 2)
  status          OrderStatus     @default(NEW)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  promocode       Promocode?      @relation(fields: [promocodeId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
  reviews         Review[]

  @@map("orders")
}

// ─────────────────────────────────────────────
// ORDER ITEMS
// ─────────────────────────────────────────────

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  modifiers  Json     @default("[]") // снимок выбранных модификаторов
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  comment    String?
  lineTotal  Decimal  @map("line_total") @db.Decimal(10, 2)

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @map("order_id")
  provider          String
  providerPaymentId String?       @map("provider_payment_id")
  status            PaymentStatus @default(created)
  amount            Decimal       @db.Decimal(10, 2)
  webhookPayload    Json?         @map("webhook_payload")
  idempotencyKey    String        @unique @map("idempotency_key")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─────────────────────────────────────────────
// TABLES
// ─────────────────────────────────────────────

model Table {
  id           String      @id @default(uuid())
  number       Int         @unique
  capacity     Int
  zone         String?
  status       TableStatus @default(available)

  reservations Reservation[]

  @@map("tables")
}

// ─────────────────────────────────────────────
// RESERVATIONS
// ─────────────────────────────────────────────

model Reservation {
  id              String            @id @default(uuid())
  tableId         String            @map("table_id")
  userId          String?           @map("user_id")
  customerName    String            @map("customer_name")
  customerPhone   String            @map("customer_phone")
  date            DateTime          @db.Date
  startTime       DateTime          @map("start_time") @db.Time
  durationMinutes Int               @map("duration_minutes")
  guestsCount     Int               @map("guests_count")
  comment         String?
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  table           Table             @relation(fields: [tableId], references: [id])
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("reservations")
}

// ─────────────────────────────────────────────
// LOYALTY ACCOUNTS
// ─────────────────────────────────────────────

model LoyaltyAccount {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  balance             Decimal   @default(0) @db.Decimal(10, 2)
  accrualPercent      Decimal   @default(0) @map("accrual_percent") @db.Decimal(5, 2)
  lastTransactionAt   DateTime? @map("last_transaction_at")

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

// ─────────────────────────────────────────────
// LOYALTY TRANSACTIONS
// ─────────────────────────────────────────────

model LoyaltyTransaction {
  id               String         @id @default(uuid())
  loyaltyAccountId String         @map("loyalty_account_id")
  type             String         // accrual | redemption
  amount           Decimal        @db.Decimal(10, 2)
  orderId          String?        @map("order_id")
  description      String?
  createdAt        DateTime       @default(now()) @map("created_at")

  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  @@map("loyalty_transactions")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String              @id @default(uuid())
  userId    String?             @map("user_id")
  type      NotificationType
  channel   NotificationChannel
  payload   Json                @default("{}")
  isRead    Boolean             @default(false) @map("is_read")
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id            String       @id @default(uuid())
  userId        String?      @map("user_id")
  orderId       String?      @map("order_id")
  productId     String?      @map("product_id")
  rating        Int          // 1–5
  text          String?
  status        ReviewStatus @default(pending)
  isPublished   Boolean      @default(false) @map("is_published")
  moderatedBy   String?      @map("moderated_by")
  moderatedAt   DateTime?    @map("moderated_at")
  rejectionReason String?    @map("rejection_reason")
  createdAt     DateTime     @default(now()) @map("created_at")

  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  product       Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  moderator     User?        @relation("ModeratedReviews", fields: [moderatedBy], references: [id], onDelete: SetNull)

  @@map("reviews")
}

// ─────────────────────────────────────────────
// ACTIVITY LOGS
// ─────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}
